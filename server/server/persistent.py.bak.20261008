"""Persistent runner rotation for atlas1/atlas2 templates.

每 ROTATION_CHECK_INTERVAL 秒检查一次配置的模板列表。若最新 template_run
的 age >= ROTATION_AGE_MIN 分钟或关联 agent 已离线，则：
1. 触发新 GitHub Actions run
2. 等待新 agent 注册并上线（超时 AGENT_ONLINE_TIMEOUT 秒）
3. 对新 agent 执行 template apply

配置（环境变量，/etc/default/oracle-agent）：
  PERSISTENT_TEMPLATES=atlas1,atlas2    # 逗号分隔的模板名
  ROTATION_AGE_MIN=355                   # run 活到多少分钟时轮换
  ROTATION_CHECK_INTERVAL=300            # 检查间隔（秒）
  AGENT_ONLINE_TIMEOUT=600               # 等新 agent 上线超时（秒）
"""
import asyncio
import logging
import os
import time
from datetime import datetime, timedelta, timezone

from . import db
from .template import apply_template, TemplateError

log = logging.getLogger("oracle.persistent")

# ── 配置 ──
PERSISTENT_TEMPLATES = [
    t.strip()
    for t in os.environ.get("PERSISTENT_TEMPLATES", "").split(",")
    if t.strip()
]
ROTATION_AGE_MIN = int(os.environ.get("ROTATION_AGE_MIN", "355"))
ROTATION_CHECK_INTERVAL = int(os.environ.get("ROTATION_CHECK_INTERVAL", "300"))
AGENT_ONLINE_TIMEOUT = int(os.environ.get("AGENT_ONLINE_TIMEOUT", "600"))
ONLINE_AFTER_SEC = 180  # 与 config.py 一致
# GitHub 单 run 硬上限 6h，超时即不可能存活；本地状态兜底回收阈值
STALE_RUN_MAX_AGE_HOURS = float(os.environ.get("STALE_RUN_MAX_AGE_HOURS", "6.5"))

# 防止同一模板并发轮换
_rotating: set[str] = set()


def _is_agent_online(agent_id: str) -> bool:
    """检查 agent 是否在线（last_seen 在 ONLINE_AFTER_SEC 内）。"""
    agent = db.get_agent(agent_id)
    if not agent:
        return False
    last_seen = agent.get("last_seen")
    if not last_seen:
        return False
    cutoff = (datetime.now(timezone.utc) - timedelta(seconds=ONLINE_AFTER_SEC)).isoformat()
    return last_seen >= cutoff


def _trigger_new_run(template_name: str) -> int | None:
    """触发新 GitHub Actions run，返回 run_id 或 None。"""
    from . import gh as gh_mod

    accounts = gh_mod.get_accounts()
    if not accounts:
        log.warning("persistent: no GitHub accounts configured")
        return None

    for pat, owner, repo in accounts:
        try:
            gh_mod.gh_request(
                "POST",
                f"/repos/{owner}/{repo}/actions/workflows/bootstrap.yml/dispatches",
                data={"ref": "main"},
            )
            # dispatch 成功后抓最新 run_id
            data = gh_mod.gh_request(
                "GET",
                f"/repos/{owner}/{repo}/actions/runs?per_page=1",
            )
            if data and data.get("workflow_runs"):
                run_id = int(data["workflow_runs"][0]["id"])
                now_s = datetime.now(timezone.utc).isoformat()
                db.create_run_provisioning(
                    run_id, now_s, github_status="queued",
                    template=template_name, origin="persistent_rotation",
                )
                return run_id
            log.warning("persistent: dispatch ok but no run_id found")
            return None
        except Exception as e:
            log.warning("persistent: trigger attempt failed for %s: %s", owner, e)
            continue

    return None


def _wait_for_agent(run_id: int, timeout: int = 600) -> str | None:
    """轮询等待新 agent 注册并上线，返回 agent_id 或 None。"""
    deadline = time.time() + timeout
    while time.time() < deadline:
        run = db.get_run(run_id)
        if run and run.get("agent_id"):
            agent_id = run["agent_id"]
            if _is_agent_online(agent_id):
                return agent_id
        time.sleep(5)
    return None


def _check_and_rotate(template_name: str):
    """检查单个模板，必要时触发轮换。同步函数，在 asyncio.to_thread 中运行。"""
    # Guard A: 同一模板全局最多一个 running template_run
    running = db.get_running_template_run(template_name)
    if running:
        log.info(
            "persistent: skip rotate for %s (already running template_run id=%d on agent=%s created_at=%s)",
            template_name,
            running.get("id"),
            running.get("agent_id"),
            running.get("created_at"),
        )
        if template_name in _rotating:
            _rotating.discard(template_name)
        return

    if template_name in _rotating:
        log.info("persistent: %s already rotating, skip", template_name)
        return
    _rotating.add(template_name)
    try:
        _do_rotate(template_name)
    finally:
        _rotating.discard(template_name)


def _do_rotate(template_name: str):
    """实际轮换逻辑。两阶段判定：

    Phase 1 — 有没有活跃的 GitHub Run？（runs 表，非终态）
        有 → 不触发（避免重复 trigger）
    Phase 2 — 最近一次 Template 是否需要轮换？（template_runs 表）
        需要 → trigger
    """
    # Phase 1: 检查 runs 表是否有活跃的 Runner Run
    active_run = db.get_latest_active_run(
        origin="persistent_rotation", template=template_name
    )
    if active_run:
        log.info(
            "persistent: %s has active run %s (status=%s, triggered=%s), skip",
            template_name, active_run["run_id"], active_run["status"],
            active_run.get("triggered_at", "?"),
        )
        return

    # Phase 2: 查最新 template_run，判断是否需要轮换
    latest = db.get_latest_template_run(template=template_name)

    need_rotate = False
    reason = ""

    if not latest or latest.get("status") != "running":
        need_rotate = True
        reason = "no active template_run" if not latest else f"last template_run status={latest.get('status')}"
    else:
        created_at = latest.get("created_at")
        agent_id = latest.get("agent_id")

        if not created_at:
            need_rotate = True
            reason = "no created_at"
        else:
            try:
                created_ts = datetime.fromisoformat(
                    created_at.replace("Z", "+00:00")
                ).timestamp()
                age_min = (time.time() - created_ts) / 60

                if age_min >= ROTATION_AGE_MIN:
                    need_rotate = True
                    reason = f"age {age_min:.1f}min >= {ROTATION_AGE_MIN}min"
                elif not agent_id:
                    need_rotate = True
                    reason = "no agent_id in template_run"
                elif not _is_agent_online(agent_id):
                    need_rotate = True
                    reason = f"agent {agent_id} offline"
                else:
                    log.info(
                        "persistent: %s OK (age=%.1fmin, agent=%s online)",
                        template_name, age_min, agent_id,
                    )
            except Exception as e:
                need_rotate = True
                reason = f"parse error: {e}"

    if not need_rotate:
        return

    log.info("persistent: rotating %s — reason: %s", template_name, reason)

    # 2. 触发新 run
    new_run_id = _trigger_new_run(template_name)
    if not new_run_id:
        log.warning(
            "persistent: trigger failed for %s, will retry next cycle",
            template_name,
        )
        return

    log.info("persistent: triggered new run %d for %s", new_run_id, template_name)

    # 3. 等新 agent 上线
    new_agent_id = _wait_for_agent(new_run_id, timeout=AGENT_ONLINE_TIMEOUT)
    if not new_agent_id:
        log.warning(
            "persistent: no agent online for run %d within %ds",
            new_run_id, AGENT_ONLINE_TIMEOUT,
        )
        return

    log.info("persistent: agent %s online for run %d", new_agent_id, new_run_id)

    # 4. 应用模板
    try:
        def on_step(i, total, name, task_id, status):
            log.info(
                "persistent: [%s] step %d/%d %s (task %s)",
                status, i + 1, total, name, task_id[:12],
            )

        res = apply_template(
            new_agent_id, template_name,
            run_id=new_run_id, on_step=on_step,
        )
        log.info(
            "persistent: template %s applied to agent %s — status: %s",
            template_name, new_agent_id, res.get("status"),
        )
    except TemplateError as e:
        log.error(
            "persistent: template apply failed for %s on agent %s: %s",
            template_name, new_agent_id, e,
        )
    except Exception as e:
        log.exception(
            "persistent: unexpected error applying template %s: %s",
            template_name, e,
        )


async def persistent_runner_loop():
    """Background task: keep configured templates' runners alive.

    在 lifespan() 中通过 asyncio.create_task() 启动。
    """
    if not PERSISTENT_TEMPLATES:
        log.info("persistent_runner_loop: PERSISTENT_TEMPLATES not set, idle")
        return

    log.info(
        "persistent_runner_loop started: templates=%s, age_threshold=%dmin, check_interval=%ds",
        PERSISTENT_TEMPLATES, ROTATION_AGE_MIN, ROTATION_CHECK_INTERVAL,
    )

    while True:
        # 兜底：回收超时仍非终态的 run，避免僵尸记录永久阻塞 Phase 1 守卫
        try:
            reaped = db.reap_stale_runs(STALE_RUN_MAX_AGE_HOURS)
            if reaped:
                log.warning(
                    "persistent: reaped %d stale run(s) older than %sh",
                    reaped, STALE_RUN_MAX_AGE_HOURS,
                )
        except Exception:
            log.exception("persistent: reap_stale_runs failed")

        for template_name in PERSISTENT_TEMPLATES:
            # 每个模板独立检查，互不阻塞
            asyncio.create_task(asyncio.to_thread(_check_and_rotate, template_name))
        await asyncio.sleep(ROTATION_CHECK_INTERVAL)
